# ─── Base de données ────────────────────────────────────────────────
# Base de développement (docker compose up -d postgres)
DATABASE_URL="postgresql://eventflow:eventflow@localhost:5432/eventflow_dev?schema=public"

# ─── Application ────────────────────────────────────────────────────
# URL publique de l'application (liens dans les e-mails, contrôle d'origine)
APP_URL="http://localhost:3000"
# Durée de validité d'une session en heures
SESSION_TTL_HOURS="12"
# Secret utilisé pour protéger l'endpoint des tâches planifiées (POST /api/jobs/alerts)
# Générer avec : openssl rand -hex 32
CRON_SECRET=""

# ─── E-mails ────────────────────────────────────────────────────────
# "file" (dev : écrit les e-mails dans storage/mail-outbox), "smtp" ou "disabled"
MAIL_DRIVER="file"
MAIL_FROM="EventFlow 3D <no-reply@example.com>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ─── Stockage des fichiers ─────────────────────────────────────────
# "local" (dev : storage/uploads) ou "s3" (production)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# Taille maximale d'un fichier téléversé (en Mo)
UPLOAD_MAX_MB="15"
S3_ENDPOINT=""
S3_REGION="eu-west-3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ─── Seed de démonstration ─────────────────────────────────────────
# Mot de passe des comptes de démonstration. Le seed refuse de s'exécuter
# si NODE_ENV=production (sauf ALLOW_DEMO_SEED=true explicite).
DEMO_PASSWORD="change-me-demo-password"
ALLOW_DEMO_SEED=true