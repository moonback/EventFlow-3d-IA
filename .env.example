# ─── Base de données ────────────────────────────────────────────────
# Base de développement (docker compose up -d postgres)
DATABASE_URL="postgresql://eventflow:eventflow@localhost:5432/eventflow_dev?schema=public"

# ─── Application ────────────────────────────────────────────────────
# URL publique de l'application (liens dans les e-mails, contrôle d'origine)
APP_URL="http://localhost:3000"
# Durée de validité d'une session en heures
SESSION_TTL_HOURS="12"
# Secret utilisé pour protéger l'endpoint des tâches planifiées (POST /api/jobs/alerts)
# Générer avec : openssl rand -hex 32
CRON_SECRET=""
# Clé de chiffrement des secrets stockés en base (clé API Gemini saisie dans Paramètres → Organisation)
# Générer avec : openssl rand -base64 32 — la perdre rend les clés enregistrées illisibles (à ressaisir)
APP_ENCRYPTION_KEY=""

# ─── E-mails ────────────────────────────────────────────────────────
# "file" (dev : écrit les e-mails dans storage/mail-outbox), "smtp" ou "disabled"
MAIL_DRIVER="file"
MAIL_FROM="EventFlow 3D <no-reply@example.com>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ─── Stockage des fichiers ─────────────────────────────────────────
# "local" (dev : storage/uploads) ou "s3" (production)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# Taille maximale d'un fichier téléversé (en Mo)
UPLOAD_MAX_MB="15"
S3_ENDPOINT=""
S3_REGION="eu-west-3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ─── Seed de démonstration ─────────────────────────────────────────
# Mot de passe des comptes de démonstration. Le seed refuse de s'exécuter
# si NODE_ENV=production (sauf ALLOW_DEMO_SEED=true explicite).
DEMO_PASSWORD="change-me-demo-password"
ALLOW_DEMO_SEED=true

# ─── Assistant vocal « Eric » (Gemini Live) ────────────────────────
# Passerelle WebSocket séparée : npm run assistant:dev (port ASSISTANT_GATEWAY_PORT)
# Identifiants Google Cloud : `gcloud auth application-default login` en développement,
# compte de service (rôle « Vertex AI User ») attaché à l'hôte en production. Jamais dans le dépôt.
ASSISTANT_ENABLED="false"
# "enterprise" (production : Google Cloud, données en Europe) ou "developer" (essais : clé Gemini API)
GEMINI_BACKEND="enterprise"
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""
# Régions proposant gemini-3.8-live : eu, us, us-central1 (eu : résidence des données en Europe)
GOOGLE_CLOUD_LOCATION="eu"
GEMINI_LIVE_MODEL="gemini-3.8-live"
# Voix prédéfinie (vide : voix par défaut du modèle). Vérifier la liste des voix disponibles en français.
GEMINI_LIVE_VOICE=""
ASSISTANT_GATEWAY_PORT="3001"
ASSISTANT_MAX_SESSION_MINUTES="30"
ASSISTANT_IDLE_SECONDS="120"
# Développement uniquement (passerelle sur un autre port que Next.js). En production, laisser vide :
# le proxy inverse route /ws/assistant vers la passerelle, sur la même origine que l'application.
NEXT_PUBLIC_ASSISTANT_WS_URL="ws://localhost:3001/ws/assistant"
