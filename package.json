{
  "name": "eventflow-3d",
  "version": "0.1.0",
  "private": true,
  "description": "ERP/CRM pour agence événementielle avec interface 3D de pilotage",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "jobs:alerts": "tsx --env-file-if-exists=.env --conditions=react-server scripts/run-alerts.ts",
    "org:create": "tsx --env-file-if-exists=.env --conditions=react-server scripts/create-organization.ts",
    "stock:reconcile": "tsx --env-file-if-exists=.env --conditions=react-server scripts/reconcile-stock.ts",
    "postinstall": "prisma generate",
    "db:seed:reset": "SEED_RESET=true tsx --env-file-if-exists=.env --conditions=react-server prisma/seed.ts",
    "models:build": "tsx scripts/build-models.ts",
    "assistant:gateway": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/assistant-gateway.ts",
    "assistant:dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/assistant-gateway.ts",
    "assistant:check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/check-live-model.ts",
    "electron:compile": "node scripts/electron/build.mjs --electron-only",
    "electron:dev": "concurrently -k -s first -n next,electron -c blue,magenta \"next dev -p 3000\" \"npm run electron:compile && wait-on -t 180000 tcp:127.0.0.1:3000 && electron .\"",
    "electron:start": "npm run electron:compile && electron .",
    "electron:build": "node scripts/electron/build.mjs",
    "electron:pack": "npm run electron:build && electron-builder --config electron-builder.config.cjs --dir",
    "electron:dist": "npm run electron:build && electron-builder --config electron-builder.config.cjs --win nsis",
    "electron:lint": "tsc -p electron/tsconfig.json && eslint electron scripts/electron tests/electron electron-builder.config.cjs playwright.electron.config.ts",
    "electron:test": "vitest run tests/unit/electron-policy.test.ts && playwright test -c playwright.electron.config.ts",
    "electron:verify": "node scripts/electron/verify-package.mjs",
    "electron:smoke": "node scripts/electron/smoke-packaged.mjs",
    "electron:icon": "node scripts/electron/make-icon.mjs"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@google/genai": "^2.29.1",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.56.0",
    "next": "^15.5.27",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.17.2",
    "postprocessing": "^6.39.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.180.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "meshoptimizer": "^0.22.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "main": "dist-electron/main.js"
}
