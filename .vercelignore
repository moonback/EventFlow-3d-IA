# Dependencies — reinstalled by Vercel during build
node_modules/

# Build output & caches — regenerated by Vercel during build
.next/
.next-e2e/
out/
*.tsbuildinfo

# Local runtime data (uploads, dev mail outbox, backups)
/storage/
backups/

# Tests & reports — not needed for the production build
coverage/
playwright-report/
test-results/
blob-report/
tests/
playwright.config.ts

# Env files — managed exclusively via the Vercel dashboard, never uploaded.
# Ignore every .env variant, then keep only the committed template.
.env*
!.env.example

# Editor / tooling
.claude/
.superpowers/
.git/
docs/

# Misc
.DS_Store
*.log
npm-debug.log*

# Application de bureau Electron : inutile au build web
electron/
dist-electron/
.next-desktop/
build/
release/
electron-builder.config.cjs
playwright.electron.config.ts
