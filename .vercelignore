# Dependencies — reinstalled by Vercel during build
node_modules/

# Build output & caches — regenerated by Vercel during build
.next/
.next-e2e/
out/
*.tsbuildinfo

# Local runtime data (uploads, dev mail outbox, backups)
/storage/
backups/

# Tests & reports
coverage/
playwright-report/
test-results/
blob-report/
tests/

# Env files — set these in the Vercel dashboard, never upload
.env
.env.local
.env.*.local
.env.test
.env.test.local

# Editor / tooling
.claude/
.superpowers/
.git/
docs/

# Misc
.DS_Store
*.log
npm-debug.log*
